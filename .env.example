# LLM: direct Anthropic API (LLM_API_KEY) or AWS Bedrock (LLM_PROVIDER=bedrock).
# For Bedrock, export AWS_BEARER_TOKEN_BEDROCK in your shell (or add it to your own .env).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
AWS_REGION=
# Trends, Slack and Adobe are local simulations: no keys needed.
# Optional: a pre-made image instead of the SVG placeholder, and a fake delay in seconds.
ADOBE_MOCK_IMAGE_URL=
ADOBE_MOCK_LATENCY_S=

# Optional
DEMO_MODE=
LIVE_TRENDS=
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
