# LLM: direct Anthropic API (LLM_API_KEY) or AWS Bedrock (LLM_PROVIDER=bedrock).
# For Bedrock, export AWS_BEARER_TOKEN_BEDROCK in your shell (or add it to your own .env).
LLM_PROVIDER=
LLM_API_KEY=
# Bedrock: eu.anthropic.claude-sonnet-4-6 works on our account (anthropic.claude-sonnet-5-5 gives 403).
LLM_MODEL=
AWS_REGION=
# Slack: incoming webhook URL (secret, never commit). Empty = the message is only previewed.
SLACK_WEBHOOK_URL=
# Public URL of the frontend (https). Lets Slack load the local demo photo; empty = no image in Slack.
# Never localhost: Slack can't download from it and then rejects the WHOLE message (Run.slack = failed).
PUBLIC_BASE_URL=
# Optional public https image for the Slack message instead (no PUBLIC_BASE_URL needed).
# If Slack can't download it, the message is retried once without the image.
SLACK_IMAGE_URL=
# Trends and Adobe are local simulations: no keys needed.
# Demo photo served by the frontend (frontend/public/visuals, CC0). Empty = SVG placeholder.
ADOBE_MOCK_IMAGE_URL=/visuals/boabe-laptop-mug.jpg
# Optional fake delay in seconds for the Adobe mock, to show loading states.
ADOBE_MOCK_LATENCY_S=

# Optional
DEMO_MODE=
LIVE_TRENDS=
# USD per million tokens, for the cost numbers. Sonnet 4.6: 3 and 15.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
